<?xml version="1.0"?>
<launch>
  <arg name="configuration_directory" default="$(find cartographer_ros)/configuration_files" />
  <arg name="configuration_basename" default="livox_2d_localization.lua" />
  <arg name="trajectory_id" default="1" />

  <node pkg="cartographer_ros"
        type="cartographer_guard.py"
        name="cartographer_guard"
        output="screen">
    
    <!-- 话题配置 -->
    <param name="score_topic" value="/matching_score" />
    <param name="scan_topic" value="/scan" />
    
    <!-- 分数触发条件 -->
    <param name="score_threshold" value="0.6" />
    <param name="score_consecutive_frames" value="10" />
    
    <!-- 雷达触发条件 -->
    <param name="scan_stable_frames" value="10" />
    <param name="scan_change_threshold" value="0.5" />
    
    <!-- 稳定期时长（秒）- 重定位后等待定位稳定 -->
    <param name="stabilizing_duration" value="10" />
    
    <!-- Cartographer 服务配置 -->
    <param name="finish_service" value="/finish_trajectory" />
    <param name="start_service" value="/start_trajectory" />
    <param name="config_dir" value="$(arg configuration_directory)" />
    <param name="config_file" value="$(arg configuration_basename)" />
    <param name="trajectory_id" value="$(arg trajectory_id)" />
    
  </node>
</launch>