<launch>
  <!--
    Autonomous Exploration Launch - Single Real Robot
    Sends PoseStamped goals to the navigation stack (move_base / NavOA).
    Does NOT publish /cmd_vel.
  -->

  <arg name="robot_name" default="car1" />
  <arg name="map_frame" default="map" />
  <arg name="base_frame" default="base_link" />

  <!-- Topics -->
  <arg name="map_topic" default="/map" />
  <arg name="odom_topic" default="/odom_rf2o" />
  <arg name="goal_topic" default="/move_base_simple/goal" />
  <arg name="cancel_topic" default="/move_base/cancel" />
  <arg name="plan_topic" default="/move_base/GlobalPlanner/plan" />
  <arg name="costmap_topic" default="/move_base/global_costmap/costmap" />

  <!-- Exploration parameters -->
  <arg name="max_steps" default="500" />
  <arg name="goal_tolerance" default="0.3" />
  <arg name="goal_timeout" default="60.0" />
  <arg name="idle_wait" default="1.0" />
  <arg name="post_reach_wait" default="2.5" />
  <arg name="min_frontier_size" default="5" />
  <arg name="exploration_method" default="whitest" />
  <arg name="inflation_cells" default="6" />

  <arg name="regional_explore" default="true" />
  <arg name="local_radius" default="60" />  <!-- grid cells, ~3m at 0.05 res -->
  <arg name="frontier_update_interval" default="5.0" />  <!-- sec, periodic recalculation -->
  <arg name="goal_check_radius" default="30" />  <!-- grid cells, ~1.5m -->

  <!-- Exploration region filter (Rviz "Publish Point" tool) -->
  <arg name="enable_region_filter" default="true" />
  <arg name="clicked_point_topic" default="/clicked_point" />
  <arg name="region_default_radius" default="3.0" />  <!-- meters, radius for single-point circle -->
  <arg name="region_shape_mode" default="polygon" />  <!-- "convex_hull" or "polygon" -->
  <arg name="region_close_threshold" default="1.5" />  <!-- meters, polygon closes when last point is this close to first -->
  <arg name="map_padding_cells" default="400" />  <!-- cells, extra canvas border for Rviz clicking (0=off) -->

  <!-- Loop closure revisit: after 20s with no new frontiers in region,
       revisit previously explored points once, then stop. -->
  <arg name="enable_loop_closure" default="true" />
  <arg name="loop_closure_min_distance" default="80" />  <!-- grid cells, ~4m at 0.05 res -->
  <arg name="loop_closure_max_revisits" default="5" />   <!-- max revisit goals -->
  <arg name="loop_closure_trigger_delay" default="20.0" />  <!-- sec, wait before triggering -->

  <arg name="visualization" default="true" />
  <arg name="save_data" default="true" />

  <!-- Terminal/topic progress bar and smoothed ETA -->
  <arg name="progress_enabled" default="true" />
  <arg name="progress_topic" default="/exploration/progress" />
  <arg name="progress_update_interval" default="5.0" />
  <arg name="progress_bar_width" default="30" />
  <arg name="progress_eta_window" default="120.0" />
  <arg name="exploration_target_ratio" default="0.95" />

  <node pkg="marl_mapping" type="exploration_node.py" name="autonomous_exploration" output="screen" respawn="false">
    <param name="robot_name" value="$(arg robot_name)" />
    <param name="map_frame" value="$(arg map_frame)" />
    <param name="base_frame" value="$(arg base_frame)" />
    <param name="map_topic" value="$(arg map_topic)" />
    <param name="odom_topic" value="$(arg odom_topic)" />
    <param name="goal_topic" value="$(arg goal_topic)" />
    <param name="cancel_topic" value="$(arg cancel_topic)" />
    <param name="max_steps" value="$(arg max_steps)" />
    <param name="goal_tolerance" value="$(arg goal_tolerance)" />
    <param name="goal_timeout" value="$(arg goal_timeout)" />
    <param name="idle_wait" value="$(arg idle_wait)" />
    <param name="post_reach_wait" value="$(arg post_reach_wait)" />
    <param name="min_frontier_size" value="$(arg min_frontier_size)" />
    <param name="exploration_method" value="$(arg exploration_method)" />
    <param name="inflation_cells" value="$(arg inflation_cells)" />
    <param name="regional_explore" value="$(arg regional_explore)" />
    <param name="local_radius" value="$(arg local_radius)" />
    <param name="frontier_update_interval" value="$(arg frontier_update_interval)" />
    <param name="goal_check_radius" value="$(arg goal_check_radius)" />
    <param name="enable_region_filter" value="$(arg enable_region_filter)" />
    <param name="clicked_point_topic" value="$(arg clicked_point_topic)" />
    <param name="region_default_radius" value="$(arg region_default_radius)" />
    <param name="region_shape_mode" value="$(arg region_shape_mode)" />
    <param name="region_close_threshold" value="$(arg region_close_threshold)" />
    <param name="map_padding_cells" value="$(arg map_padding_cells)" />
    <param name="visualization" value="$(arg visualization)" />
    <param name="save_data" value="$(arg save_data)" />
    <param name="progress_enabled" value="$(arg progress_enabled)" />
    <param name="progress_topic" value="$(arg progress_topic)" />
    <param name="progress_update_interval" value="$(arg progress_update_interval)" />
    <param name="progress_bar_width" value="$(arg progress_bar_width)" />
    <param name="progress_eta_window" value="$(arg progress_eta_window)" />
    <param name="exploration_target_ratio" value="$(arg exploration_target_ratio)" />
    <param name="plan_watch_enabled" value="true" />
    <param name="plan_topic" value="$(arg plan_topic)" />
    <param name="costmap_topic" value="$(arg costmap_topic)" />
    <param name="enable_loop_closure" value="$(arg enable_loop_closure)" />
    <param name="loop_closure_min_distance" value="$(arg loop_closure_min_distance)" />
    <param name="loop_closure_max_revisits" value="$(arg loop_closure_max_revisits)" />
    <param name="loop_closure_trigger_delay" value="$(arg loop_closure_trigger_delay)" />
  </node>
</launch>
