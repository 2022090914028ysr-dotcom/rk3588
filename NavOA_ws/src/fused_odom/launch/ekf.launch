<launch>

  <node pkg="tf2_ros" type="static_transform_publisher" name="imu_to_base" 
        args="0 0 0 0 0 0 base_footprint imu_link" />
  

  <node pkg="robot_localization" type="ekf_localization_node" name="ekf_odom" clear_params="true" output="screen">
    <rosparam command="load" file="$(find fused_odom)/config/ekf.yaml" />
  </node>

  <!-- <node name="send_imu" pkg="NavOA_ros" type="imu_publish.py" output="screen" /> -->
</launch>
