<?xml version="1.0"?>
<!--
  cartographer_guard_imu_score.launch

  Combined guard: IMU fall detection + matching-score-based triggering.
  Both paths use the same recovery: hard reset (kill nodes + roslaunch relaunch).

  IMU path:  detects roll/pitch fall → upright confirmed → hard reset
  Score path: detects low matching score → hard reset

  Both can be toggled independently via imu_enabled / score_enabled.
-->
<launch>
  <arg name="configuration_directory" default="$(find cartographer_ros)/configuration_files" />
  <arg name="configuration_basename" default="livox_2d_localization_fast_reloc.lua" />
  <arg name="load_state_filename" default="$(find cartographer_ros)/../../../map/meeting_room/test00.pbstream" />

  <node pkg="cartographer_ros"
        type="cartographer_guard_imu_score.py"
        name="cartographer_guard_imu_score"
        output="screen">

    <!-- ============================================================ -->
    <!-- Enable / disable each detection source                        -->
    <!-- ============================================================ -->
    <param name="imu_enabled"   value="true" />
    <param name="score_enabled" value="true" />

    <!-- ============================================================ -->
    <!-- IMU fall detection (roll/pitch only)                          -->
    <!-- ============================================================ -->
    <param name="imu_topic" value="/imu_serial" />

    <param name="fall_roll_threshold_deg"     value="20.0" />
    <param name="fall_pitch_threshold_deg"    value="30.0" />
    <param name="upright_roll_threshold_deg"  value="5.0" />
    <param name="upright_pitch_threshold_deg" value="10.0" />
    <param name="upright_confirm_frames"      value="5" />
    <param name="min_pending_duration"        value="1.5" />

    <!-- ============================================================ -->
    <!-- Score-based triggering                                        -->
    <!-- ============================================================ -->
    <param name="score_topic" value="/matching_score" />
    <param name="score_threshold"          value="0.40" />
    <param name="score_consecutive_frames" value="10" />

    <!-- ============================================================ -->
    <!-- Offset-based triggering (map→base_footprint jump detection)    -->
    <!--   Only active after cartographer has been running for          -->
    <!--   offset_startup_delay seconds.                               -->
    <!-- ============================================================ -->
    <param name="offset_enabled"            value="true" />
    <param name="offset_threshold"          value="1.5" />
    <param name="offset_consecutive_frames" value="1" />
    <param name="offset_startup_delay"      value="30.0" />
    <param name="map_frame"                 value="map" />
    <param name="base_frame"                value="base_footprint" />

    <!-- ============================================================ -->
    <!-- Rotation-based triggering (yaw jump detection in map frame)   -->
    <!--   Same startup delay as offset. Triggers when |Δyaw| >        -->
    <!--   rotation_threshold_deg for N consecutive frames.            -->
    <!-- ============================================================ -->
    <param name="rotation_enabled"            value="true" />
    <param name="rotation_threshold_deg"      value="70.0" />
    <param name="rotation_consecutive_frames" value="1" />

    <!-- ============================================================ -->
    <!-- Shared cooldown (applies to IMU, score, offset, rotation)     -->
    <!-- ============================================================ -->
    <param name="reset_cooldown" value="10.0" />

    <!-- ============================================================ -->
    <!-- Max idle timeout (0 = disabled)                               -->
    <!-- Forces a fresh restart if no trigger has fired in this many   -->
    <!-- seconds.  Any existing trigger resets the timer.              -->
    <!-- ============================================================ -->
    <param name="max_idle_timeout" value="1200.0" />

    <!-- ============================================================ -->
    <!-- Hard reset config (shared by both paths)                      -->
    <!-- ============================================================ -->
    <param name="cartographer_node_name"      value="/cartographer_node" />
    <param name="cartographer_grid_node_name" value="/cartographer_occupancy_grid_node" />
    <param name="reset_launch_package"        value="cartographer_ros" />
    <param name="reset_launch_file"           value="cartographer_localization_runtime.launch" />
    <param name="config_dir"                  value="$(arg configuration_directory)" />
    <param name="config_file"                 value="$(arg configuration_basename)" />
    <param name="load_state_filename"         value="$(arg load_state_filename)" />

  </node>
</launch>
