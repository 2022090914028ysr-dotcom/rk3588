<?xml version="1.0"?>
<launch>
  <arg name="map_dir" default="$(find cartographer_ros)/../carto_ws/map/meeting_room" />
  <arg name="load_state_filename" default="$(arg map_dir)/test9.pbstream" />
  <arg name="launch_rviz" default="false" />
  <param name="/use_sim_time" value="false" />
  

  <!-- Latched static TF: tf2_ros publishes once to /tf_static, so cartographer's
       TF buffer never misses base_footprint->laser_frame, even on first startup. -->
  <!-- <node pkg="tf2_ros" type="static_transform_publisher" name="base_link_to_laser"
    args="0 0 0.2 -1.57 0 0 base_footprint laser_frame" /> -->

 <!-- <include file="$(find rf2o_laser_odometry)/launch/rf2o_laser_odometry.launch" /> -->

 <!-- <node pkg="NavOA_ros" name="multi_ultrasonic_scan" type="multi_ultrasonic_scan.py" output="screen" /> -->

  <!-- Static map server: serves the pre-built map on /map.
       This is the clean global map from the pbstream, with NO ghost submaps from
       recovery trajectories. move_base global costmap uses this for path planning.
       cartographer_occupancy_grid_node is kept for debug visualization only (/carto_submap_viz). -->
  <arg name="map_file" default="$(arg map_dir)/test9.yaml" />
  <node name="map_server" pkg="map_server" type="map_server"
        args="$(arg map_file)" output="screen">
    <!-- map_server publishes on /map and /map_metadata by default -->
  </node>
  <!-- cartographer_node loads the .pbstream and auto-starts a trajectory
       using the FAST Lua (livox_2d_localization_fast_reloc.lua). The
       switch_lua node schedules a one-shot fast→slow swap at T=20 s,
       capturing the current map→base_footprint pose so localization
       continues seamlessly under the slow Lua. The same node also runs
       the runtime score / offset / rotation guards. -->
  <node name="cartographer_node" pkg="cartographer_ros" type="cartographer_node"
        args="-configuration_directory $(find cartographer_ros)/configuration_files
               -configuration_basename livox_2d_localization_fast_reloc.lua
               -load_state_filename $(arg load_state_filename)" output="screen">
    <remap from="scan" to="/scan" />
    <remap from="odom" to="/odom_rf2o" />
  </node>


  <!-- occupancy_grid_node publishes on /carto_submap_viz for debug/RViz only.
       It is NOT /map — that comes from map_server above.
       This lets you see where Cartographer places new submaps without affecting
       the navigation costmap. -->
  <node name="cartographer_occupancy_grid_node" pkg="cartographer_ros"
        type="cartographer_occupancy_grid_node"
        args="-resolution 0.05 -include_unfrozen_submaps=false">
    <remap from="map" to="/carto_submap_viz" />
  </node>

    <!-- <node if="$(arg launch_rviz)" name="rviz" pkg="rviz" type="rviz" required="true"
      args="-d $(find cartographer_ros)/configuration_files/demo_2d.rviz" /> -->
    
        
</launch>