  <!-- <node pkg="tf" type="static_transform_publisher" name="base_link_to_laser"
    args="0.0 0.0 0.0 -1.57 0.0 0.0 /base_link /laser_frame 40" />

 <include file="$(find rf2o_laser_odometry)/launch/rf2o_laser_odometry.launch" />
 
 <node pkg="NavOA_ros" name="multi_ultrasonic_scan" type="multi_ultrasonic_scan.py" output="screen" /> -->

  <node name="cartographer_node" pkg="cartographer_ros" type="cartographer_node" 
        args="-configuration_directory $(find cartographer_ros)/configuration_files
               -configuration_basename livox_2d.lua" output="screen">
    <remap from="scan" to="/scan" />
    <remap from="imu" to="/imu/data"/>
    <!-- <remap from="odom" to="/odom" />                 EKF mode (default): fused odom -->
    <!-- <remap from="odom" to="/odom_rf2o" /> -->   <!-- rf2o-only: comment above, uncomment this -->
    <!-- <remap from="odom" to="/SMX/Odom" /> -->    <!-- leg-only: comment above, uncomment this -->
    <remap from="odom" to="/SMX/Odom_flat" />
  </node>


  <node name="cartographer_occupancy_grid_node" pkg="cartographer_ros"
        type="cartographer_occupancy_grid_node" args="-resolution 0.05" />


  <node name="rviz" pkg="rviz" type="rviz" required="false"
        args="-d $(find cartographer_ros)/configuration_files/demo_2d.rviz" />
</launch>