<launch>
    <!-- HP60C depth camera + depth2laser + scan merge to /mergescan -->

    <arg name="argPath" default="$(find ascamera)/configurationfiles"/>
    <arg name="fps" default="30"/>

    <!-- merge /scan + /camscan -> /mergescan -->
    <node pkg="ascamera" name="scan_merger" type="scan_merge.py" output="screen">
        <param name="topic_a"       type="str"   value="/scan"/>
        <param name="topic_b"       type="str"   value="/camscan"/>
        <param name="output_frame"  type="str"   value="base_footprint"/>
        <param name="timeout"       type="double" value="1.0"/>
        <param name="angle_offset_a" type="double" value="-0.7854"/>
        <param name="angle_offset_b" type="double" value="0"/>   <!-- camscan -90 deg CCW -->
    </node>

</launch>
