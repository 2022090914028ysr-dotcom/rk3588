<launch>
  <arg name="use_camera" default="true"/>
  <arg name="use_ultrasonic" default="false"/>
  <arg name="argPath" default="$(find ascamera)/configurationfiles"/>
  <arg name="fps" default="30"/>
  <arg name="launch_rviz" default="false"/>
  <arg name="rviz_config" default="$(find NavOA_ros)/example/gazebo_limo/rviz/robit_map.rviz"/>

  <!-- HP60C depth camera -->
   <group if="$(arg use_camera)">
    <node pkg="ascamera" name="ascamera_hp60c" type="ascamera_node" respawn="true" output="screen">
      <param name="depth_width"  type="int" value="640"/>
      <param name="depth_height" type="int" value="480"/>
      <param name="rgb_width"    type="int" value="640"/>
      <param name="rgb_height"   type="int" value="480"/>
      <param name="fps"          type="int" value="$(arg fps)"/>
      <param name="usb_bus_no"   type="int" value="-1"/>
      <param name="usb_path"     type="str" value="null"/>
      <param name="confiPath"    type="str" value="$(arg argPath)"/>
      <param name="color_pcl"    type="boolean" value="false"/>
      <param name="pub_mono8"    type="boolean" value="false"/>
      <param name="pub_tfTree"   type="boolean" value="true"/>
    </node>

  <!--  <node pkg="ascamera" name="depth_to_laserscan" type="depth_to_laserscan.py" output="screen">
      <param name="depth_topic"  type="str"   value="/ascamera_hp60c/depth0/image_raw"/>
      <param name="scan_rows"      type="int"   value="0"/>
      <param name="scan_row_start" type="int"   value="80"/>
      <param name="scan_row_end"   type="int"   value="320"/>
      <param name="range_min"    type="double" value="0.0"/>
      <param name="range_max"    type="double" value="5"/>
      <param name="output_frame" type="str"   value="base_link"/>
      <param name="fy"           type="double" value="420.85"/>
      <param name="cy"           type="double" value="240.69"/>
      <param name="camera_height" type="double" value="0.3"/>
      <param name="ground_tolerance" type="double" value="0.25"/>
      <param name="range_offset" type="double" value="0.13"/>
      <param name="angle_offset" type="double" value="0.1"/>
      <param name="pub_rate"    type="double" value="10"/>
    </node>
  --> </group>

  <node name="lidar_node"  pkg="lidar_ros"  type="lidar_node" output="screen" respawn="false" >
    <param name="serial_name"                 type="string" value="/dev/ttyS4"/>  
    <param name="serial_baud"                 type="int" value="230400"/>  
    <param name="frame_id"                    type="string" value="laser_frame"/>
    <param name="counterclockwise"            type="bool"   value="true"/>
    <param name="angle_min"                   type="double" value="-180.0" />
    <param name="angle_max"                   type="double" value="180" />
    <param name="range_min"                   type="double" value="0.1" />
    <param name="range_max"                   type="double" value="15" />
    <param name="resolution_fixed"            type="bool"   value="false"/>
    <param name="angle_corp_string"           type="string" value="" />
  </node>

  <node pkg="tf2_ros" type="static_transform_publisher" name="base_link_to_laser"
      args="0 0 0.2 0 0 0 base_link laser_frame" />
  <node pkg="tf2_ros" type="static_transform_publisher" name="base_link_to_imu"
      args="0 0 0 0 0 0 base_link imu_link" />

  <!-- 2-way merge: /camscan + /scan -> /mergescan  (ultrasonic removed; used as virtual bumper in vel_filter) -->
  <!-- <node pkg="ascamera" name="scan_merger" type="scan_merge.py" output="screen">
    <param name="topics"        type="yaml"  value="['/scan', '/camscan','/voscan']"/>
    <param name="angle_offsets" type="yaml"  value="[-0.7854, 0.0,0.0]"/>
    <param name="output_frame"  type="str"   value="base_link"/>
    <param name="timeout"       type="double" value="1.0"/>
    <param name="pub_rate"     type="double" value="10"/>
  </node> -->
  <include file="$(find rf2o_laser_odometry)/launch/rf2o_laser_odometry.launch" />
  <!-- EKF fusion: rf2o (/odom_rf2o) + leg (SMX/Odom) + IMU (/imu/data) -> /odom + odom->base_link TF.
       When the EKF is ON it is the SOLE publisher of /odom AND odom->base_link TF, so:
         - the relays below must stay OFF (EKF supplies /odom directly), and
         - rf2o publish_tf AND the leg node publish_tf must BOTH be false. -->
  <include file="$(find rf2o_laser_odometry)/launch/ekf_fusion.launch" />

  <!-- ODOM SOURCE — relay to /odom so move_base's local planner gets velocity.
       EKF mode (default): EKF publishes /odom directly -> keep BOTH relays off.
       rf2o-only: comment the EKF <include> above, uncomment the rf2o relay.
       leg-only: comment the EKF <include> above, uncomment the leg relay. -->
  <!-- <node pkg="topic_tools" type="relay" name="rf2o_odom_relay" args="/odom_rf2o /odom" /> -->
  <!-- <node pkg="topic_tools" type="relay" name="leg_odom_relay" args="/SMX/Odom /odom" /> -->

  <!-- Split leg yaw onto its own topic for the EKF's absolute-yaw input (odom2 in
       ekf_params.yaml). SMX/Odom position stays differential (odom1); yaw is fused
       absolute (odom2) as the coarse heading anchor that breaks 180° scan-matching
       symmetry. topic_tools relay = zero-code copy of the message. -->
  <node pkg="topic_tools" type="relay" name="leg_yaw_relay" args="SMX/Odom /SMX/Odom_yaw" />

  <!-- Keep the leg odometry (SMX/Odom) origin aligned with rf2o.
       Startup:   aligns the leg to rf2o's CURRENT pose (the robot may already have
       turned before this 3 s delay fires — zeroing to identity left it ~40° off in
       the v2 bag). Falls back to identity only if rf2o isn't fresh yet.
       Reconnect: if the leg drops out and resumes, re-anchors it to rf2o's CURRENT pose.
       Persistent node: the latch must stay alive to re-deliver the reset to a
       restarted fusion_estimator_node. -->
  <node pkg="NavOA_ros" type="align_leg_origin.py" name="align_leg_origin"
        output="screen" required="false">
    <param name="delay_s" value="3.0" />
    <param name="leg_topic" value="SMX/Odom" />
    <param name="rf2o_topic" value="/odom_rf2o" />
    <param name="dropout_timeout" value="1.0" />
  </node>

  
  
  <node pkg="NavOA_ros" name="multi_ultrasonic_scan" type="multi_ultrasonic_scan.py" output="screen" if="$(arg use_ultrasonic)" />
  <!-- Bridge /cmd_vel and IMU over /dev/ttyS6 to the other PC -->
  <!-- <node pkg="NavOA_ros" type="serial_cmd_vel_imu_bridge.py" name="serial_cmd_vel_imu_bridge" output="screen">
    <param name="serial_port" value="/dev/ttyS1" />
    <param name="baudrate" value="460800" />
    <param name="serial_timeout" value="0.02" />
    <param name="cmd_send_rate_hz" value="80.0" />
    <param name="tx_queue_size" value="200" />
    <param name="serial_flush_interval" value="0.05" />
    <param name="cmd_vel_topic" value="/cmd_vel" />
    <param name="button_topic" value="/app_controller/button" /> -->
    <!-- Publish IMU from serial onto /imu_serial; mux will prioritize this -->
    <!-- <param name="imu_topic" value="/imu_serial" />
    <param name= "event_topic" value="/nav_serial/event" />
    <param name="verbose" value="false" />
  </node> -->

  <!-- IMU mux: prefer serial IMU (/imu_serial), fall back to ROS /imu -->
  <node pkg="NavOA_ros" type="imu_mux.py" name="imu_mux" output="screen">
    <param name="primary_topic" value="/imu_serial" />
    <param name="fallback_topic" value="/imu" />
    <param name="output_topic" value="/imu_mux" />
    <param name="timeout" value="0.2" />
  </node>

  <!-- NavOA navigation stack (move_base + velocity filter + status + goal timeout) -->
  <include file="$(find NavOA_ros)/launch/navoa_nav_only.launch">
    <arg name="use_sim_time"       value="false"/>
    <arg name="enable_map_server"  value="false"/>
    <arg name="global_map_topic"   value="/map"/>
    <arg name="launch_rviz"        value="$(arg launch_rviz)"/>

  </include>
  
  <node pkg = "rosbridge_server" type="rosbridge_websocket" name="rosbridge_websocket" output="screen">
    <param name="port" value="9090"/>
  </node>

</launch>
   