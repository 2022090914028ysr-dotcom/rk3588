<launch>
  <arg name="use_sim_time" default="false" />
  <param name="use_sim_time" value="$(arg use_sim_time)" />

  <!-- LiDAR driver -->
  <include file="$(find lidar_ros)/launch/lidar.launch" />

  <!-- Laser odometry and odom -> base_footprint TF -->
  <include file="$(find rf2o_laser_odometry)/launch/rf2o_laser_odometry.launch" />
  <include file="$(find rf2o_laser_odometry)/launch/ekf_fusion.launch" />

  <!-- SLAM Toolbox mapping node -->
  <node pkg="slam_toolbox" type="async_slam_toolbox_node" name="slam_toolbox" output="screen">
    <rosparam command="load" file="$(find NavOA_ros)/param/slam_toolbox_params.yaml" />
  </node>

  <!-- NavOA navigation node with the same map/base/lidar frames -->
  <!-- <include file="$(find NavOA_ros)/example/gazebo_limo/launch/NavOA_gazebo_limo.launch">
    <arg name="map_frame" value="map" />
    <arg name="base_frame" value="base_footprint" />
    <arg name="lidar_frame" value="laser_frame" />
  </include> -->

  
</launch>
