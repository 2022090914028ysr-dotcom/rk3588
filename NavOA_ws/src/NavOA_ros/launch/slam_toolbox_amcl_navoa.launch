<launch>
  <arg name="use_sim_time" default="false" />
  <arg name="map_file" default="$(find NavOA_ros)/example/gazebo_limo/maps/slamtoolbox_map.yaml" />
  <arg name="odom_frame" default="odom" />
  <arg name="base_frame" default="base_footprint" />
  <arg name="scan_topic" default="/scan" />
  <arg name="odom_topic" default="/odom" />

  <param name="use_sim_time" value="$(arg use_sim_time)" />

  <rosparam command="load" file="$(find NavOA_ros)/param/amcl_params.yaml" />

  <node pkg="map_server" type="map_server" name="map_server" output="screen"
        args="$(arg map_file)" />

  <node pkg="amcl" type="amcl" name="amcl" output="screen">
    <param name="use_map_topic" value="false" />
    <param name="gui" value="false" />
    <param name="odom_frame_id" value="$(arg odom_frame)" />
    <param name="base_frame_id" value="$(arg base_frame)" />
    <param name="global_frame_id" value="map" />
    <param name="scan_topic" value="$(arg scan_topic)" />
    <remap from="odom" to="$(arg odom_topic)" />
  </node>

  <include file="$(find NavOA_ros)/launch/localization_recovery.launch">
    <param name="localization_mode" value="amcl" />
    <param name="global_localization_service" value="/global_localization" />
    <param name="publish_initialpose" value="true" />
  </include>

  <include file="$(find lidar_ros)/launch/lidar.launch" />
  <include file="$(find rf2o_laser_odometry)/launch/rf2o_laser_odometry.launch" />
  <include file="$(find rf2o_laser_odometry)/launch/ekf_fusion.launch" />

  <!-- <include file="$(find NavOA_ros)/example/gazebo_limo/launch/NavOA_gazebo_limo.launch">
    <arg name="map_frame" value="map" />
    <arg name="base_frame" value="base_footprint" />
    <arg name="lidar_frame" value="laser_frame" />
  </include> -->

  <!-- Bridge /cmd_vel and IMU over /dev/ttyS6 to the other PC -->
  <node pkg="NavOA_ros" type="serial_cmd_vel_imu_bridge.py" name="serial_cmd_vel_imu_bridge" output="screen">
    <param name="serial_port" value="/dev/ttyS7" />
    <param name="baudrate" value="230400" />
    <!-- Publish IMU from serial onto /imu_serial; mux will prioritize this -->
    <param name="imu_topic" value="/imu_serial" />
  </node>

  <!-- IMU mux: prefer serial IMU (/imu_serial), fall back to ROS /imu -->
  <node pkg="NavOA_ros" type="imu_mux.py" name="imu_mux" output="screen">
    <param name="primary_topic" value="/imu_serial" />
    <param name="fallback_topic" value="/imu" />
    <param name="output_topic" value="/imu_mux" />
    <param name="timeout" value="0.2" />
  </node>







</launch>
