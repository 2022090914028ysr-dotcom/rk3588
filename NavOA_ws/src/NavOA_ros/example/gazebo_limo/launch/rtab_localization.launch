<launch>
    <!-- 
        RTAB-Map Localization Launch File
        For use with NavOA navigation after mapping is complete
        
        IMPORTANT: After launching, use RViz "2D Pose Estimate" to set robot position!
    -->
    
    <arg name="database_path" default="~/.ros/rtabmap.db"/>
    <arg name="use_sim_time" default="false"/>
    <arg name="frame_id" default="ascamera_hp60c_color_0"/>
    
    <!-- Publish a static /map frame as a fallback until RTAB-Map initializes -->
    <node pkg="tf" type="static_transform_publisher" name="map_broadcaster"
          args="0 0 0 0 0 0 map odom 100"/>
    
    <include file="$(find rtabmap_launch)/launch/rtabmap.launch">
        <arg name="use_sim_time"            value="$(arg use_sim_time)"/>
        <arg name="database_path"           value="$(arg database_path)"/>
        <arg name="frame_id"                value="$(arg frame_id)"/>
        <arg name="map_frame_id"            value="map"/>
        <arg name="odom_frame_id"           value="odom"/>
        <arg name="localization"            value="true"/>
        <arg name="visual_odometry"         value="true"/>
        <arg name="publish_tf_map"          value="true"/>
        <arg name="rgb_topic"               value="/ascamera_hp60c/rgb0/image"/>
        <arg name="depth_topic"             value="/ascamera_hp60c/depth0/image_raw"/>
        <arg name="camera_info_topic"       value="/ascamera_hp60c/rgb0/camera_info"/>
        <arg name="scan_topic"              value="/scan"/>
        <arg name="odom_topic"              value="/odom"/>
        <arg name="approx_sync"             value="true"/>
        <arg name="approx_sync_max_interval"    value="0.5"/>
        <arg name="depth_scale"                 value="0.001"/>
        <arg name="subscribe_scan"             value="false"/>

        <arg name="rviz"                   value="false"/>
        <arg name="rtabmap_viz"            value="true"/>
    </include>
</launch>
