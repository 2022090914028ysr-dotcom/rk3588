<launch>

  <!-- 参数定义 -->
  <arg name="scan_topic" default="/limo/scan" />
  <arg name="map_frame" default="map" />
  <arg name="odom_frame" default="odom" />
  <arg name="base_frame" default="base_link" />
  <arg name="map_name" default="gazebo_limo_map" />
  <arg name="save_location" default="$(find NavOA_ros)/maps" />

  <!-- Gmapping SLAM 建图节点 -->
  <node pkg="gmapping"
        type="slam_gmapping"
        name="slam_gmapping"
        output="screen">

    <!-- 启用粒子云发布 -->
    <param name="publish_particles" value="true" />
    <param name="particles" value="100" />

    <!-- 坐标系设置 -->
    <param name="map_frame" value="$(arg map_frame)" />
    <param name="odom_frame" value="$(arg odom_frame)" />
    <param name="base_frame" value="$(arg base_frame)" />

    <!-- 激光雷达参数 -->
    <param name="maxUrange" value="5.0" />
    <param name="maxRange" value="5.0" />
    <remap from="scan" to="$(arg scan_topic)" />

    <!-- 地图范围与分辨率 -->
    <param name="xmin" value="-20" />
    <param name="ymin" value="-20" />
    <param name="xmax" value="20" />
    <param name="ymax" value="20" />
    <param name="delta" value="0.05" />

    <!-- 更新频率 -->
    <param name="linearUpdate" value="0.2" />
    <param name="angularUpdate" value="0.2" />
    <param name="temporalUpdate" value="1.0" />

    <!-- 粒子云话题重映射 -->
    <remap from="particlecloud" to="/particlecloud" />
  </node>

  <!-- 持续自动保存地图 -->
  <node name="continuous_map_saver"
        pkg="roscpp_tutorials"
        type="listener"
        args=""
        output="screen"
        launch-prefix="bash -c 'mkdir -p $(arg save_location); while true; do sleep 10; echo [Map Saver] Saving map...; rosrun map_server map_saver -f $(arg save_location)/$(arg map_name); done &amp; sleep infinity'"
        required="true" />

</launch>
