<launch>
  <arg name="scan_topic" default="/scan" />
  <arg name="save_path" default="$(find NavOA_ros)/example/gazebo_limo/maps" />
  <arg name="map_name" default="limo_carto" />

  <node name="cartographer_node" pkg="cartographer_ros"
      type="cartographer_node" args="
          -configuration_directory $(find NavOA_ros)/example/gazebo_limo/config
          -configuration_basename limo_2d.lua"
      output="screen">
    <remap from="scan" to="$(arg scan_topic)" />
    </node>

  <node name="cartographer_occupancy_grid_node" pkg="cartographer_ros"
      type="cartographer_occupancy_grid_node" args="-resolution 0.05" />

  <node name="auto_map_saver" pkg="roscpp_tutorials" type="listener" output="screen"
      launch-prefix="bash -c '
          mkdir -p $(arg save_path); 
          while true; do 
              rosrun map_server map_saver -f $(arg save_path)/$(arg map_name); 
              echo [AutoSaver] Map saved; 
              sleep 10; 
          done; 
          # 注意：去掉了 & 和 sleep infinity，也不需要执行后面的 listener 了
          exit 0 # 强制退出，不执行真正的 listener
          ' " />

    

</launch>