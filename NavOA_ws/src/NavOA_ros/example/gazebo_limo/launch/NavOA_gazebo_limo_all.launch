<launch>
  <!-- <node name="pub_imu" pkg="NavOA_ros" type="imu_publish.py" output="screen" /> -->
  
  <node pkg="tf" type="static_transform_publisher" name="base_to_imu" 
      args="0 0 0 0 0 0 base_footprint imu_link 100" />

  <!-- Convert depth image to synthetic laser and merge with lidar -->
  <!-- <include file="$(find NavOA_ros)/example/gazebo_limo/launch/depth_to_laserscan.launch" /> -->
  
  <!-- Lidar driver publishes /scan and base_footprint->laser_frame TF -->
  <include file="$(find lidar_ros)/launch/lidar.launch" />
  <!-- RF2O consumes /scan and publishes /odom plus odom->base_footprint TF -->
  <include file="$(find rf2o_laser_odometry)/launch/rf2o_laser_odometry.launch" />

  <!-- Add move_base global planning based on a map (map_file arg forwarded) -->


  
  <arg name="map_file" default="/home/ubuntu/Robit_SlamNav/NavOA_ws/src/NavOA_ros/example/gazebo_limo/maps/limo_carto.yaml" />
  <include file="$(find NavOA_ros)/example/gazebo_limo/launch/global_planner.launch">
    <arg name="map_file" value="$(arg map_file)" /> 
  </include>

  <include file="$(find NavOA_ros)/example/gazebo_limo/launch/carto_localization.launch" />


  <!-- Real robot command bridge listening on /cmd_vel -->

</launch>