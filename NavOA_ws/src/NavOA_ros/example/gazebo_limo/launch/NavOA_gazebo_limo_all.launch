<launch>
  <arg name="use_sim_time" default="false"/>
  <arg name="imu_topic" default="/imu_mux"/>
  <arg name="imu_time_offset" default="0.12"/>
  <arg name="camera_fps" default="15"/>
  <arg name="rtabmap_subscribe_scan" default="false"/>
  <arg name="enable_laser_ekf_odometry" default="true"/>
  <arg name="use_rtabmap_visual_odometry" default="false"/>
  <param name="use_sim_time" value="$(arg use_sim_time)"/>
    <node pkg="tf2_ros" type="static_transform_publisher" name="base_to_imu"
      args="0 0 0 0 0 0 base_footprint imu_link" />

  <include file="$(find ascamera)/launch/hp60c.launch">
    <arg name="fps" value="$(arg camera_fps)" />
  </include>
  <!-- Convert depth image to synthetic laser and merge with lidar -->
  <include file="$(find NavOA_ros)/example/gazebo_limo/launch/depth_to_laserscan.launch" />
  
  <!-- Lidar driver publishes /scan and base_footprint->laser_frame TF -->
  <include file="$(find lidar_ros)/launch/lidar.launch" />
  <!-- rf2o is the default odometry source while camera registration is unresolved. -->
  <include if="$(arg enable_laser_ekf_odometry)" file="$(find rf2o_laser_odometry)/launch/rf2o_laser_odometry.launch" />
  <include unless="$(arg enable_laser_ekf_odometry)" file="$(find rf2o_laser_odometry)/launch/rf2o_laser_odometry.launch">
    <arg name="odom_topic" value="/odom" />
  </include>

  <!-- Fuse rf2o with IMU through robot_localization when enabled. -->
  <include if="$(arg enable_laser_ekf_odometry)" file="$(find rf2o_laser_odometry)/launch/ekf_fusion.launch" />

  <!-- <include file="$(find NavOA_ros)/launch/voice_nav.launch"> -->
    <!-- <arg name="places_yaml" value="$(find NavOA_ros)/example/gazebo_limo/config/voice_places.yaml" /> -->
  <!-- </include> -->

  <!-- Add move_base global planning based on a map (map_file arg forwarded) -->


  

  <arg name="map_file" default="/home/ubuntu/Robit_SlamNav/NavOA_ws/src/NavOA_ros/example/gazebo_limo/maps/rtabmap/rtabmap.yaml" />
  <include file="$(find NavOA_ros)/example/gazebo_limo/launch/global_planner.launch">
    <arg name="map_file" value="$(arg map_file)" /> 
  </include>

  <include file="$(find NavOA_ros)/example/gazebo_limo/launch/rtab_map.launch">
    <arg name="imu_topic" value="$(arg imu_topic)" />
    <arg name="visual_odometry" value="$(arg use_rtabmap_visual_odometry)" />
    <arg name="odom_topic" value="/odom" />
    <arg name="odom_frame_id" value="odom" />
    <arg name="subscribe_scan" value="$(arg rtabmap_subscribe_scan)" />
  </include>

  <node unless="$(arg enable_laser_ekf_odometry)" pkg="NavOA_ros" type="odom_topic_to_tf.py" name="odom_topic_to_tf" output="screen" launch-prefix="python3">
    <param name="odom_topic" value="/odom" />
    <param name="parent_frame" value="odom" />
    <param name="child_frame" value="base_footprint" />
    <param name="flatten_2d" value="true" />
  </node>


  <!-- Real robot command bridge listening on /cmd_vel -->

  <!-- Bridge /cmd_vel and IMU over /dev/ttyS6 to the other PC -->
  <node pkg="NavOA_ros" type="serial_cmd_vel_imu_bridge.py" name="serial_cmd_vel_imu_bridge" output="screen">
    <param name="serial_port" value="/dev/ttyS7" />
    <param name="baudrate" value="230400" />
    <!-- Publish IMU from serial onto /imu_serial; mux will prioritize this -->
    <param name="imu_topic" value="/imu_serial" />
    <param name="imu_time_offset" value="$(arg imu_time_offset)" />
    <param name="imu_min_dt" value="0.001" />
    <param name="imu_max_future" value="0.2" />
    <param name="prefer_device_stamp" value="true" />
  </node>

  <!-- IMU mux: prefer serial IMU (/imu_serial), fall back to ROS /imu -->
  <node pkg="NavOA_ros" type="imu_mux.py" name="imu_mux" output="screen">
    <param name="primary_topic" value="/imu_serial" />
    <param name="fallback_topic" value="/imu" />
    <param name="output_topic" value="$(arg imu_topic)" />
    <param name="timeout" value="0.2" />
  </node>

</launch>
