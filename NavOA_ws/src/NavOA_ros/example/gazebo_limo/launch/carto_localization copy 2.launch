<launch>
  <arg name="scan_topic" default="/scan" />
  <arg name="imu_topic" default="/imu" />
  <arg name="odom_topic" default="/odom" /> <!-- 新增 -->

  <arg name="map_dir" default="$(find NavOA_ros)/example/gazebo_limo/maps" />
  <arg name="map_index" default="1" /> <!-- 1 表示按目录名排序最早的地图 -->
  <arg name="map_filename" default="limo_map.pbstream" />
  <arg name="load_state_filename" default="$(eval import os; d=arg('map_dir'); subs=sorted([x for x in os.listdir(d) if os.path.isdir(os.path.join(d, x))]); idx=max(0, min(len(subs)-1, int(arg('map_index'))-1)) if subs else 0; base=subs[idx] if subs else ''; os.path.join(d, base, arg('map_filename')))" />

  <node name="cartographer_node" pkg="cartographer_ros"
      type="cartographer_node" args="
          -configuration_directory $(find NavOA_ros)/example/gazebo_limo/config
          -configuration_basename limo_localization.lua
          -load_state_filename $(arg load_state_filename)" 
      output="screen">
    <remap from="scan" to="$(arg scan_topic)" />
    <remap from="imu" to="$(arg imu_topic)" />
    <remap from="odom" to="$(arg odom_topic)" /> <!-- 关键：订阅里程计 -->

    <!-- 关键：提高 TF 发布频率到 100Hz -->
    <param name="tf_publish_duration" value="0.01" />
    
    <!-- 可选：显式指定 frame（确保与你的 TF 树一致） -->
    <param name="odom_frame" value="odom" />
    <param name="published_frame" value="odom" />
  </node>

  <node name="cartographer_occupancy_grid_node" pkg="cartographer_ros"
      type="cartographer_occupancy_grid_node" args="-resolution 0.05" />

</launch>

<!-- roslaunch NavOA_ros gazebo_limo/launch/carto_localization.launch map_index:=1 -->