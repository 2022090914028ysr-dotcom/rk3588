<launch>
  <arg name="scan_topic" default="/scan" />
  <arg name="imu_topic" default="/imu" />
  
  <arg name="load_state_filename" default="$(find NavOA_ros)/example/gazebo_limo/maps/limo_map.pbstream" />

  <node name="cartographer_node" pkg="cartographer_ros"
      type="cartographer_node" args="
          -configuration_directory $(find NavOA_ros)/example/gazebo_limo/config
          -configuration_basename limo_localization.lua
          -load_state_filename $(arg load_state_filename)" 
      output="screen">
    <remap from="scan" to="$(arg scan_topic)" />
    <remap from="imu" to="$(arg imu_topic)" />
  </node>

  <node name="cartographer_occupancy_grid_node" pkg="cartographer_ros"
      type="cartographer_occupancy_grid_node" args="-resolution 0.05" />

  <!-- <node name="rviz" pkg="rviz" type="rviz" required="true" 
        args="-d $(find NavOA_ros)/example/gazebo_limo/rviz/limo_gazebo.rviz" /> -->

</launch>