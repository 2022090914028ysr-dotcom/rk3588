<launch>
  <arg name="scan_topic" default="/scan" />
  <!-- Use muxed IMU by default; can still be overridden by caller -->
  <arg name="imu_topic" default="/imu_mux" />
  <arg name="odom_topic" default="/odom" />
  <arg name="load_state_filename" default="$(find NavOA_ros)/example/gazebo_limo/maps/quan/limo_map.pbstream" />

  <node name="cartographer_node" pkg="cartographer_ros"
      type="cartographer_node" args="
          -configuration_directory $(find NavOA_ros)/example/gazebo_limo/config
          -configuration_basename limo_localization_fast.lua
          -load_state_filename $(arg load_state_filename)" 
      launch-prefix="taskset -c 6,7"
      output="screen">
      
    <remap from="scan" to="$(arg scan_topic)" />
    <remap from="imu" to="$(arg imu_topic)" />
    <remap from="odom" to="$(arg odom_topic)" />

    <param name="tf_publish_duration" value="0.01" />
    <param name="odom_frame" value="odom" />
    <param name="published_frame" value="base_footprint" />
    <param name="map_frame" value="map" />
  </node>

  <node name="cartographer_occupancy_grid_node" pkg="cartographer_ros"
      type="cartographer_occupancy_grid_node" args="-resolution 0.05" 
      launch-prefix="taskset -c 0"/>


</launch>