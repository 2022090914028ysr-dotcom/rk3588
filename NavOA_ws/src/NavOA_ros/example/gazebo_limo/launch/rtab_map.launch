<launch>
    <!-- 
        RTAB-Map Mapping Launch File
        External odometry is the default source.
        RGB-D visual odometry can be re-enabled explicitly after the camera publishes
        registered depth aligned with the RGB optical frame.
    -->
    
    <arg name="database_path" default="/home/ubuntu/.ros/rtabmap.db"/>
    <arg name="use_sim_time" default="false"/>
    <arg name="frame_id" default="base_footprint"/>
    <arg name="imu_topic" default="/imu_mux"/>
    <arg name="odom_topic" default="/odom"/>
    <arg name="odom_frame_id" default="odom"/>
    <arg name="visual_odometry" default="false"/>
    <arg name="wait_imu_to_init" default="true"/>
        <arg name="subscribe_scan" default="false"/>
        <arg name="approx_sync_max_interval" default="0.08"/>
        <arg name="wait_for_transform" default="0.2"/>
        <arg name="topic_queue_size" default="2"/>
        <arg name="sync_queue_size" default="8"/>
        <arg name="rgbd_decimation" default="1"/>
    <arg name="rtabmap_viz" default="true"/>
    <arg name="rviz" default="true"/>
    
        <!-- Map-level registration settings. Prefer visual 3DoF registration in the
            default humanoid path so RGB-D odometry is not blocked by scan timing. -->
        <rosparam command="load" file="$(find NavOA_ros)/example/gazebo_limo/config/rtabmap_visual_3dof.yaml" ns="rtabmap/rtabmap"/>
    <!-- Odometry-specific filtering and planar constraints for optional RGB-D odometry. -->
    <rosparam if="$(arg visual_odometry)" command="load" file="$(find NavOA_ros)/example/gazebo_limo/config/rtabmap_rgbd_imu_odometry.yaml" ns="rtabmap/rgbd_odometry"/>
    
    <include file="$(find rtabmap_launch)/launch/rtabmap.launch">
        <arg name="use_sim_time"            value="$(arg use_sim_time)"/>
        <arg name="database_path"           value="$(arg database_path)"/>
        <arg name="frame_id"                value="$(arg frame_id)"/>
        <arg name="map_frame_id"            value="map"/>
        <arg name="odom_frame_id"           value="$(arg odom_frame_id)"/>
        <arg name="localization"            value="false"/>
        <arg name="visual_odometry"         value="$(arg visual_odometry)"/>
        <arg name="publish_tf_map"          value="true"/>
        <arg name="publish_tf_odom"         value="false"/>
        <arg name="rgb_topic"               value="/ascamera_hp60c/rgb0/image"/>
        <arg name="depth_topic"             value="/ascamera_hp60c/depth0/image_raw"/>
           <!-- The depth stream must already be registered into the RGB optical frame.
               The live HP60C stack currently publishes unregistered depth on
               ascamera_hp60c_depth_0, so camera-side registration must be fixed for
               stable RGB-D odometry. -->
           <arg name="camera_info_topic"       value="/ascamera_hp60c/rgb0/camera_info"/>
        <arg name="scan_topic"              value="/merged_scan"/>
        <arg name="odom_topic"              value="$(arg odom_topic)"/>
        <arg name="vo_frame_id"             value="$(arg odom_frame_id)"/>
        <arg name="imu_topic"               value="$(arg imu_topic)"/>
        <arg name="wait_imu_to_init"        value="$(arg wait_imu_to_init)"/>
        <arg name="approx_sync"             value="true"/>
        <arg name="approx_sync_max_interval"    value="$(arg approx_sync_max_interval)"/>
        <arg name="depth_scale"                 value="0.001"/>
        <arg name="rgbd_decimation"             value="$(arg rgbd_decimation)"/>
        <arg name="subscribe_scan"             value="$(arg subscribe_scan)"/>
        <arg name="wait_for_transform"         value="$(arg wait_for_transform)"/>
        <arg name="topic_queue_size"           value="$(arg topic_queue_size)"/>
        <arg name="sync_queue_size"            value="$(arg sync_queue_size)"/>

        <arg name="rviz"                   value="$(arg rviz)"/>
        <arg name="rtabmap_viz"            value="$(arg rtabmap_viz)"/>
    </include>
</launch>
