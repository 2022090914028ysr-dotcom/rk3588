<launch>
  <!-- Sample goals from frontier (gray area boundary) and publish to 2D nav goal -->
  <arg name="target_topic" default="/move_base_simple/goal" />
  <arg name="frame_id" default="map" />
  <arg name="map_topic" default="/map" />
  <arg name="interval_sec" default="5.0" />
  <arg name="arrival_tolerance" default="0.3" />
  <arg name="timeout_sec" default="30.0" />
  <arg name="republish_on_timeout" default="true" />
  <arg name="sample_count" default="5" />
  <!-- Optional bbox filter: xmin xmax ymin ymax -->
  <arg name="area_bbox" default="" />
  <arg name="base_frame" default="base_footprint" />

  <node name="goal_sampler" pkg="NavOA_ros" type="goal_publisher_node.py" output="screen">
    <param name="mode" value="sample_unknown" />
    <param name="target_topic" value="$(arg target_topic)" />
    <param name="frame_id" value="$(arg frame_id)" />
    <param name="map_topic" value="$(arg map_topic)" />
    <param name="interval_sec" value="$(arg interval_sec)" />
    <param name="arrival_tolerance" value="$(arg arrival_tolerance)" />
    <param name="timeout_sec" value="$(arg timeout_sec)" />
    <param name="republish_on_timeout" value="$(arg republish_on_timeout)" />
    <param name="sample_count" value="$(arg sample_count)" />
    <param name="base_frame" value="$(arg base_frame)" />
    <!-- Pass bbox if needed, e.g., "-2 2 -1 3" -->
    <param name="area_bbox" value="$(arg area_bbox)" />
  </node>
</launch>
