<?xml version="1.0"?>
<launch>
  <arg name="configuration_directory" default="$(find cartographer_ros)/configuration_files" />
  <arg name="configuration_basename" default="livox_2d_localization.lua" />
  <arg name="map_trajectory_id" default="0" />
  <arg name="active_trajectory_id" default="1" />

  <node pkg="cartographer_ros"
        type="cartographer_guard.py"
        name="cartographer_guard"
        output="screen">
    <param name="imu_topic" value="/imu" />
    <param name="pose_topic" value="/tracked_pose" />
    <param name="pose_msg_type" value="pose_stamped" />

    <param name="enable_fall_monitor" value="true" />
    <param name="enable_pose_monitor" value="true" />
    <param name="enable_score_monitor" value="false" />

    <param name="finish_service_name" value="/finish_trajectory" />
    <param name="start_service_name" value="/start_trajectory" />
    <param name="configuration_directory" value="$(arg configuration_directory)" />
    <param name="configuration_basename" value="$(arg configuration_basename)" />
    <param name="map_trajectory_id" value="$(arg map_trajectory_id)" />
    <param name="active_trajectory_id" value="$(arg active_trajectory_id)" />

    <param name="restart_use_initial_pose" value="false" />
    <param name="restart_seed_source" value="last_good" />
    <param name="debug_log" value="true" />
  </node>
</launch>
