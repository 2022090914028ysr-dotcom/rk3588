<launch>
  <arg name="map_file" default="$(find NavOA_ros)/example/gazebo_limo/maps/hector_map.yaml"/>
  <arg name="odom_frame" default="odom"/>
  <arg name="base_frame" default="base_footprint"/>
  <arg name="scan_topic" default="/scan"/>
  <arg name="odom_topic" default="/odom"/> <!-- or /odom_rf2o if needed -->

  <rosparam command="load" file="$(find NavOA_ros)/param/amcl_params.yaml" />

  <node pkg="map_server" type="map_server" name="map_server" output="screen"
        args="$(arg map_file)" />

  <node pkg="amcl" type="amcl" name="amcl" output="screen">
    <param name="use_map_topic" value="false"/>
    <param name="gui" value="false"/>
    <param name="odom_frame_id" value="$(arg odom_frame)"/>
    <param name="base_frame_id" value="$(arg base_frame)"/>
    <param name="global_frame_id" value="map"/>
    <param name="scan_topic" value="$(arg scan_topic)"/>
    <remap from="odom" to="$(arg odom_topic)"/>
  </node>
</launch>