<?xml version="1.0" encoding="utf-8"?>
<!-- bringup_no_carto.launch
     Launched by hard_reset_seeded.sh at startup.
     = your original carto launch MINUS cartographer_node and
       cartographer_occupancy_grid_node (those two are managed by the sh via
       rosrun, so a trigger only restarts the carto service, not these nodes).
     rviz is required="false" so closing rviz does not bring the whole stack down. -->
<launch>
  <arg name="launch_rviz" default="true" />
  <arg name="map_file" default="/home/ubuntu/Robit_SlamNav/NavOA_ws/src/carto_ws/map/meeting_room/test12.yaml" />
  <param name="/use_sim_time" value="false" />

  <node name="lidar_node" pkg="lidar_ros" type="lidar_node" output="screen" respawn="false">
    <param name="serial_name" type="string" value="/dev/ttyS4"/>
    <param name="serial_baud" type="int" value="230400"/>
    <param name="frame_id" type="string" value="laser_frame"/>
    <param name="counterclockwise" type="bool" value="true"/>
    <param name="angle_min" type="double" value="-180.0" />
    <param name="angle_max" type="double" value="180" />
    <param name="range_min" type="double" value="0.1" />
    <param name="range_max" type="double" value="15" />
    <param name="resolution_fixed" type="bool" value="false"/>
    <param name="angle_corp_string" type="string" value="" />
  </node>

  <node pkg="tf" type="static_transform_publisher" name="base_link_to_laser"
    args="0.0 0.0 0.2 -1.57 0.0 0.0 /base_footprint /laser_frame 40" />

  <include file="$(find rf2o_laser_odometry)/launch/rf2o_laser_odometry.launch" />

  <node name="map_server" pkg="map_server" type="map_server"
        args="$(arg map_file)" output="screen" />

  <node pkg="NavOA_ros" name="multi_ultrasonic_scan" type="multi_ultrasonic_scan.py" output="screen" />
  
  <!-- <node if="$(arg launch_rviz)" name="rviz" pkg="rviz" type="rviz" required="false"
      args="-d $(find cartographer_ros)/configuration_files/demo_2d.rviz" /> -->
</launch>
